<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="pista_octavo">
    <static>true</static>

    <!-- Textured map floor. Copy map_similarity_crop.png into:
         models/manual_pallet_track/materials/textures/map_similarity_crop.png -->
    <link name="map_floor">
      <pose>2.4200 1.8350 0.001 0 0 0</pose>
      <visual name="map_floor_visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>6.8400 5.6700</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://pista_octavo/materials/textures/map_similarity_crop.png</albedo_map>
            </metal>
          </pbr>
          <script>
            <uri>model://pista_octavo/materials/scripts</uri>
            <uri>model://pista_octavo/materials/textures</uri>
            <name>pista_octavo/MapTexture</name>
          </script>
        </material>
        <cast_shadows>false</cast_shadows>
      </visual>
      <collision name="map_floor_collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>6.8400 5.6700</size>
          </plane>
        </geometry>
      </collision>
    </link>

