<sdf version="1.4">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0 0 0 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <include><uri>model://simple_light</uri></include> 
    <light name='point_light_0' type='point'>
      <pose frame=''>1 -1 1 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>0</cast_shadows>
      <direction>-0.3 0.3 -1</direction>
    </light>
    <light name='point_light_1' type='point'>
      <pose frame=''>-1 1 1 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>0</cast_shadows>
      <direction>0.3 -0.3 -1</direction>
    </light>

    <!-- Base and ArUcos -->
    <include><uri>model://puzzlebot_base</uri></include>
    <include><name>marker_0</name><uri>model://aruco_marker_0</uri><pose>2.5 -0.5 0.091 0 0 3.141592654</pose></include>
    <include><name>marker_1</name><uri>model://aruco_marker_1</uri><pose>2.5 2.5 0.091 0 0 4.7123</pose></include>
    <include><name>marker_2</name><uri>model://aruco_marker_2</uri><pose>-0.5 2.5 0.091 0 0 0</pose></include>
    <include><name>marker_3</name><uri>model://aruco_marker_3</uri><pose>-0.5 -0.5 0.091 0 0 1.5708</pose></include>

    <!-- Goals -->
    <include><name>goal_1</name><uri>model://goal_marker_5</uri><pose>0 0 0.01 0 0 0</pose></include>
    <include><name>goal_2</name><uri>model://goal_marker_5</uri><pose>2 0 0.01 0 0 0</pose></include>
    <include><name>goal_3</name><uri>model://goal_marker_5</uri><pose>2 2 0.01 0 0 0</pose></include>
    <include><name>goal_4</name><uri>model://goal_marker_5</uri><pose>0 2 0.01 0 0 0</pose></include>

    <!-- ── NEW OBSTACLES ── -->
    <model name="box1">
      <pose>1.0 0.0 0.15 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box2">
      <pose>2.0 1.0 0.15 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box3">
      <pose>1.0 2.0 0.15 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box4">
      <pose>0.0 1.0 0.15 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
