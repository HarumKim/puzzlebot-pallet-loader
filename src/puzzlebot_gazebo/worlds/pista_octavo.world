<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pista_octavo_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://pista_octavo</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ArUco markers para localización EKF -->
    <!-- Pista: x=[0, 4.84], y=[0, 3.67] — marcadores en las 4 esquinas interiores -->
   
    <!-- ArUco markers para localización EKF -->
<!-- Pista: x=[0, 4.84], y=[0, 3.67] -->
<!-- Marcadores pegados a las paredes de cada esquina, pero dentro de la pista -->

   <!-- ArUco markers para localización EKF -->
<!-- Pista aprox: x=[0, 4.84], y=[0, 3.67] -->
<!-- Marcadores pegados a paredes, mirando hacia el interior -->


<include>
  <name>marker_0</name>
  <uri>model://aruco_marker_0</uri>
  <pose>4.58 0.05 0.092 0 0 1.5708</pose>
</include>

<include>
  <name>marker_1</name>
  <uri>model://aruco_marker_1</uri>
  <pose>4.80 3.05 0.092 0 0 3.141592654</pose>
</include>

<include>
  <name>marker_2</name>
  <uri>model://aruco_marker_2</uri>
  <pose>0.65 3.65 0.092 0 0 4.71239</pose>
</include>

<include>
  <name>marker_3</name>
  <uri>model://aruco_marker_3</uri>
  <pose>0.05 0.65 0.092 0 0 0.0</pose>
</include>
  </world>
</sdf>




